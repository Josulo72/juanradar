# Copia este archivo como .env y rellena lo que necesites. Todo es opcional.

# Servidor
SP_HOST=127.0.0.1
SP_PORT=8787
# 1 = exigir API key siempre (si ya has creado alguna, se exige automáticamente)
SP_AUTH=0

# Navegador
SP_BROWSER_POOL=3
SP_HEADLESS=1
SP_TIMEOUT_MS=30000
SP_WORKERS=4
SP_RESPECT_ROBOTS=1

# Proxies rotativos (separados por comas). Ej.: http://usuario:clave@host:puerto,socks5://host:1080
SP_PROXIES=

# LLM para summary, json, extract y robots con prompt. Basta con dos líneas:
#   SP_LLM_PROVIDER=<proveedor>
#   SP_LLM_API_KEY=<tu clave>
# Proveedores listos: anthropic, openai, gemini, groq, deepseek, mistral, openrouter, together, xai,
#                     ollama (local, sin clave), lmstudio (local, sin clave)
# Cualquier otra API compatible con OpenAI: SP_LLM_PROVIDER=custom + SP_LLM_BASE_URL=https://.../v1 (+ clave si pide)
# SP_LLM_MODEL es opcional: cambia el modelo por defecto del proveedor.
# Comprueba la configuración en http://127.0.0.1:8787/v1/llm  (o POST /v1/llm/test para una llamada real)
SP_LLM_PROVIDER=
SP_LLM_API_KEY=
SP_LLM_MODEL=
SP_LLM_BASE_URL=

# Firma HMAC de los webhooks (cabecera X-ScraperPro-Signature)
SP_WEBHOOK_SECRET=

# Buscador propio opcional (SearXNG)
SP_SEARXNG_URL=
